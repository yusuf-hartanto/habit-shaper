# -----------------------------------------------------------------------------
# Habit Shaper - Environment Template
# Copy to `.env` and adjust values. All variables are optional:
# compose.yml provides safe defaults so `docker compose up` works without .env.
# -----------------------------------------------------------------------------

# --- Database (MySQL 8.0) ---
DB_ROOT_PASSWORD=rootpassword
DB_NAME=habit_shaper
DB_USER=habituser
DB_PASSWORD=habitpassword

# --- Backend ---
NODE_ENV=production
JWT_SECRET=habit_jwt_secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# --- Host port mappings ---
DB_PORT=3306
BACKEND_PORT=4000
FRONTEND_PORT=3000
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- Mail / SMTP (Mailpit) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM="Habit Shaper <no-reply@habitshaper.local>"
